{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "domains": {
      "drizzle": "none",
      "next": "none",
      "playwright": "none",
      "project": "all",
      "qwik": "none",
      "react": "all",
      "reactNative": "none",
      "solid": "none",
      "svelte": "none",
      "tailwind": "none",
      "test": "all",
      "turborepo": "none",
      "types": "all",
      "vue": "none"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "preset": "all",
        "useImportExtensions": "off"
      },
      "performance": {
        "preset": "all",
        "noDynamicNamespaceImportAccess": "error",
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off",
        "useTopLevelRegex": "off"
      },
      "security": {
        "preset": "all"
      },
      "style": {
        "noDefaultExport": "error",
        "noNonNullAssertion": "off",
        "useComponentExportOnlyModules": "off",
        "useConsistentTypeDefinitions": "error",
        "useExportsLast": "error"
      },
      "suspicious": {
        "preset": "all",
        "noBitwiseOperators": "off",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error"]
          }
        },
        "noShadowRestrictedNames": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["data/**", "vite.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["vite.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
